#!/usr/bin/env python3
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from opr_source_risk.detect import compose_ports, nginx_listen, python_bind_all, systemd_listen

GO = [
    re.compile(r"ListenAndServe\(\s*\":"),
    re.compile(r"0\.0\.0\.0"),
    re.compile(r"INADDR_ANY"),
]

payload = json.load(sys.stdin)
root = Path(payload["root"])
findings = []
for rel in payload.get("files") or []:
    path = root / rel
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        continue
    name = path.name.lower()
    suffix = path.suffix.lower()
    chunk = []
    if suffix == ".py":
        chunk = python_bind_all(text, rel)
    elif suffix in {".service", ".socket"}:
        chunk = systemd_listen(text, rel)
    elif name in {"docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml"}:
        chunk = compose_ports(text, rel)
    elif name == "nginx.conf" or suffix == ".conf":
        chunk = nginx_listen(text, rel)
    elif suffix in {".go", ".c", ".cc", ".cpp", ".rs"}:
        for i, line in enumerate(text.splitlines(), 1):
            if "127.0.0.1" in line:
                continue
            if any(p.search(line) for p in GO):
                chunk.append(
                    {
                        "facet": "net.listen-all",
                        "title": "Binds or listens on all interfaces",
                        "severity": "high",
                        "confidence": "heuristic",
                        "path": rel,
                        "line": i,
                        "evidence": line.strip()[:240],
                    }
                )
    findings.extend(chunk)
json.dump({"check_id": "net.listen-all", "status": "ok", "findings": findings}, sys.stdout)
