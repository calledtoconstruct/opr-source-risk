#!/usr/bin/env python3
import json
import re
import sys
from pathlib import Path

PATTERNS = [
    re.compile(r"-----BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY-----"),
    re.compile(r"AKIA[0-9A-Z]{16}"),
]

payload = json.load(sys.stdin)
root = Path(payload["root"])
findings = []
for rel in payload.get("files") or []:
    path = root / rel
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        continue
    for i, line in enumerate(text.splitlines(), 1):
        for pat in PATTERNS:
            if pat.search(line):
                findings.append(
                    {
                        "facet": "secret.in-tree",
                        "title": "Secret material in source tree",
                        "severity": "high",
                        "confidence": "heuristic",
                        "path": rel,
                        "line": i,
                        "evidence": line.strip()[:80],
                    }
                )
                break
json.dump({"check_id": "secret.in-tree", "status": "ok", "findings": findings}, sys.stdout)
