#!/usr/bin/env python3
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from opr_source_risk.detect import curl_pipe_shell

payload = json.load(sys.stdin)
root = Path(payload["root"])
findings = []
for rel in payload.get("files") or []:
    path = root / rel
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        continue
    findings.extend(curl_pipe_shell(text, rel))
json.dump(
    {"check_id": "install.curl-pipe-shell", "status": "ok", "findings": findings},
    sys.stdout,
)
